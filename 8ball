    T:Toggle({ Flag = "learn", Title = "Learn and use memory", Default = true, Callback = function(v) S.learn = v end })
    T:Space()
    T:Button({
        Title = "View statistics", Justify = "Center", Icon = "",
        Callback = function()
            local lines = {}
            for kind, k in pairs(Mem.kinds) do
                table.insert(lines, string.format("%s %d/%d", kind, k.ok, k.n))
            end
            table.sort(lines)
            local b = Mem.breaks[1]
            local bt = b and string.format(" | best break: %.1f in, %.1f balls avg (%d attempts)", b.y, b.pots / b.trials, b.trials) or ""
            note("Memory", string.format("%d shots. %s%s", Mem.shots, #lines > 0 and table.concat(lines, ", ") or "no data", bt))
        end,
    })
    T:Space()
    T:Button({ Title = "Save memory now", Justify = "Center", Icon = "", Callback = function() memDirty = true memSave(true) note("Memory", "Saved") end })
    T:Space()
    T:Button({ Title = "Clear memory", Color = Color3.fromHex("#ff4830"), Justify = "Center", Icon = "trash", Callback = function() memClear() note("Memory", "Cleared") end })
end

